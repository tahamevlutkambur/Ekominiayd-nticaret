# ==============================================================================
# Ekomini Aydın Ticaret - Apache / cPanel / LiteSpeed Konfigürasyonu
# ==============================================================================

# UTF-8 Desteği
AddDefaultCharset UTF-8
DefaultLanguage tr-TR

Options -MultiViews +FollowSymLinks
RewriteEngine On
RewriteBase /

# 1. HTTPS Yönlendirmesi (SSL Zorunlu Kıl)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Var olan dosya veya klasörlere doğrudan erişim ver
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Clean URLs: /yakuplu-tekel -> /yakuplu-tekel.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L,QSA]

# 4. Alt dizin veya kök dizin için ek eşleşme
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L,QSA]

# 5. Özel 404 Hata Sayfası ve Otomatik Yönlendirici
ErrorDocument 404 /404.html

# 6. Güvenlik Başlıkları
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. Tarayıcı Önbellekleme (Google PageSpeed & SEO Hız)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# 8. Gzip / Deflate Sıkıştırma
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
